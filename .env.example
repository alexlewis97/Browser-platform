# Default CDP endpoint of the user's Chrome (enable chrome://inspect/#remote-debugging).
BROWSER_PLATFORM_CDP_URL=http://127.0.0.1:9222

# Default OpenRouter model (the API key is sent per request, never stored).
BROWSER_PLATFORM_DEFAULT_MODEL=qwen/qwen3.7-flash

# Data directory for workflows and run telemetry (no secrets).
BROWSER_PLATFORM_DATA_DIR=./data

# Path to official stock Pomerado MCP (via node_host/src/stock-mcp.mjs).
BROWSER_PLATFORM_POMERADO_HOST=node_host/src/stock-mcp.mjs

# Shared access token required on tunneled API routes (except /health).
# Generate a long random value. The mobile app stores it in localStorage
# and sends it as the X-Browser-Platform-Token header.
BROWSER_PLATFORM_ACCESS_TOKEN=

# Comma-separated allowed browser origins (the Vercel production URL).
# Leave empty for local-only use (CORS allows all origins).
BROWSER_PLATFORM_CORS_ORIGINS=

# Bind address. 127.0.0.1 (default) is laptop-only; no access token is required for
# localhost requests unless REQUIRE_TOKEN_ON_LOCALHOST=true. Non-local requests still
# need the token when ACCESS_TOKEN is set.
BROWSER_PLATFORM_HOST=127.0.0.1
BROWSER_PLATFORM_PORT=8745
BROWSER_PLATFORM_REQUIRE_TOKEN_ON_LOCALHOST=false

# Auto-launch the installed Chrome (or Playwright Chromium) on CDP 9222 if free.
BROWSER_PLATFORM_AUTO_LAUNCH_CHROME=true

# Pomerado minting is optional. Set false, or leave default (skipped automatically if Node is missing).
BROWSER_PLATFORM_POMERADO_ENABLED=true

# Do not put OPENAI_API_KEY here (and never in the Windows zip). On Windows the
# key is entered in Settings and stored only under
# %LOCALAPPDATA%\BrowserPlatform\secrets. You may export it in the process
# environment instead. OpenRouter keys stay in the browser's localStorage.
