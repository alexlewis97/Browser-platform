{
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|backend\\.json|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/backend.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
