{
  "manifest_version": 3,
  "name": "Browser Platform",
  "version": "1.2.0",
  "description": "Record a flow in your own Chrome, clean it into a reusable workflow, and replay it in the current tab. Browse a private marketplace.",
  "icons": {},
  "action": {
    "default_title": "Browser Platform"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://browser-platform-web.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://browser-platform-web.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://browser-platform-web.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
