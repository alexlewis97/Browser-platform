{
  "name": "example_com_heading",
  "description": "Read the title and page text on example.com (read-only smoke workflow).",
  "version": "1",
  "input_schema": [],
  "cache_results": true,
  "steps": [
    {
      "type": "navigation",
      "description": "Open example.com",
